<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DRN Telemetry Bridge"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Вікно локального перегляду камери на екрані телефону -->
        <androidx.cardview.widget.CardView
            android:id="@+id/previewCard"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.camera.view.PreviewView
                android:id="@+id/viewFinder"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="MJPEG: http://[IP]:8888/stream\nViewer: http://[IP]:8888/\nHealth: http://[IP]:8888/health\nTelemetry: UDP 14550"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/previewCard"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/videoStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="MJPEG TX: 0 kbps | Frame: 0 KB"
            android:textColor="#2196F3"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/status"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Налаштування роздільної здатності -->
        <TextView
            android:id="@+id/resLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Роздільна здатність: 640x480"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/videoStats"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/resButtonGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/resLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/res640Btn"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:text="640x480" />

            <Button
                android:id="@+id/res720Btn"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:text="1280x720" />

            <Button
                android:id="@+id/res1080Btn"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:text="1920x1080" />
        </LinearLayout>

        <!-- Налаштування FPS -->
        <TextView
            android:id="@+id/fpsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Частота кадрів: 15 FPS"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/resButtonGroup"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/fpsButtonGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/fpsLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/fps5Btn"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:text="5 FPS" />

            <Button
                android:id="@+id/fps10Btn"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:text="10 FPS" />

            <Button
                android:id="@+id/fps15Btn"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:text="15 FPS" />

            <Button
                android:id="@+id/fps30Btn"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:text="30 FPS" />
        </LinearLayout>

        <TextView
            android:id="@+id/zoomLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Zoom: 1.0x"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/fpsButtonGroup"
            app:layout_constraintStart_toStartOf="parent" />

        <SeekBar
            android:id="@+id/zoomSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            app:layout_constraintTop_toBottomOf="@id/zoomLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/qualityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Якість відео (JPEG): 40%"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/zoomSeekBar"
            app:layout_constraintStart_toStartOf="parent" />

        <SeekBar
            android:id="@+id/qualitySeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="40"
            app:layout_constraintTop_toBottomOf="@id/qualityLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tailscaleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tailscale: перевірка..."
            android:textColor="#FF9800"
            app:layout_constraintTop_toBottomOf="@id/qualitySeekBar"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/dimScreenButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Економія батареї (Згасити екран)"
            app:layout_constraintTop_toBottomOf="@id/tailscaleStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/openBrowserButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Відкрити стрім у браузері"
            app:layout_constraintTop_toBottomOf="@id/dimScreenButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Зупинити сервіс"
            app:layout_constraintTop_toBottomOf="@id/openBrowserButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
